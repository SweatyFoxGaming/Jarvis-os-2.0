; config/eww/eww.yuck
;
; jarvis_thought is a single \n-joined string (see eww-adapter.ts) rather
; than a real list, since yuck has no native list-of-strings eww var type
; that `eww update` can push a JSON array into cleanly — splitting on \n at
; render time with {{}} string interpolation is simpler than wiring a
; second IPC shape just for this one field.

(defvar jarvis_badge "idle")
(defvar jarvis_status "Idle")
(defvar jarvis_thought "")
(defvar jarvis_note "None yet")

(defwidget badge-dot []
  (box :class "badge-dot badge-${jarvis_badge}"))

(defwidget hud []
  (box :class "hud" :orientation "v" :space-evenly false
    (box :class "hud-header" :orientation "h" :space-evenly false
      (badge-dot)
      (label :class "hud-status" :text jarvis_status))
    (box :class "hud-section" :orientation "v" :space-evenly false
      (label :class "hud-label" :text "Thinking")
      (label :class "hud-thought" :wrap true :limit-width 42 :text jarvis_thought))
    (box :class "hud-section" :orientation "v" :space-evenly false
      (label :class "hud-label" :text "Last note")
      (label :class "hud-note" :wrap true :limit-width 42 :text jarvis_note))))

(defwindow jarvis-hud
  :monitor 0
  :geometry (geometry :x "16px" :y "16px" :width "280px" :height "160px" :anchor "top right")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore false
  (hud))

; config/eww/eww.yuck
;
; Orb-only HUD — no text panel. jarvis_badge (pushed by eww-bridge.ts)
; drives which orb-state class is applied via badge-class below.
; jarvis_status/jarvis_thought/jarvis_task/jarvis_notes (the old text-panel
; defvars) were removed in Task 7: eww-bridge.ts no longer pushes them
; (nothing in this file rendered them since the orb-only rebuild), and
; with the pushes gone, the "Variable X not scope" crash risk that
; previously required keeping them as unused defvars no longer applies —
; there's nothing left calling `eww update` with those keys.
;
; jarvis_badge's real values, confirmed against src/interaction/hud-badge.ts
; (deriveHudBadge) and src/ipc/eww-bridge.ts's `eww update` call sites:
; "idle" | "thinking" | "executing" | "error".
;
; :stacking "bg" confirmed supported by the installed eww binary (0.6.0,
; X11-only build — see report) via yuck::config::window_definition's
; WindowStacking::from_str ("background"|"bg") and eww's X11 display
; backend, which maps WindowStacking::Background to
; window.set_keep_below(true) — the real, working "don't sit on top of
; every window" mechanism for this host, not :windowtype "desktop". Task 7
; confirmed this live via X11 protocol inspection (_NET_WM_STATE_BELOW is
; set on the mapped window, and _NET_CLIENT_LIST_STACKING places it below
; a freshly-focused overlapping test window) — see Task 7 report.

(defvar jarvis_badge "idle")

(defwidget orb []
  (box :class "orb-stage"
    (box :class "orb-ping orb-badge-${jarvis_badge}")
    (box :class "orb-ping orb-ping-delay orb-badge-${jarvis_badge}")
    (box :class "orb-core orb-badge-${jarvis_badge}")))

(defwindow jarvis-hud
  :monitor 0
  :geometry (geometry :x "16px" :y "16px" :width "160px" :height "160px" :anchor "top right")
  :stacking "bg"
  :windowtype "dock"
  :wm-ignore false
  (orb))

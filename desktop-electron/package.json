{
  "name": "jarvis-os-desktop",
  "version": "1.0.0",
  "description": "Jarvis OS Desktop HUD Interface",
  "homepage": "https://github.com/SweatyFoxGaming/Jarvis-os-2.0",
  "author": {
    "name": "SweatyFoxGaming",
    "email": "dev@jarvis-os.local"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.jarvis.os.desktop",
    "productName": "Jarvis OS",
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "launch.sh",
      "assets/**/*"
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "SweatyFoxGaming <dev@jarvis-os.local>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    }
  }
}

# ---------- API Security ----------
# Required. The Python gateway (src/api.py) now fails to start if this is
# unset. Must be at least 16 characters. Generate one with:
#   openssl rand -hex 32
# Set to a long random string — the same value Express reads via
# src/kernel/auth-middleware.ts's ADMIN_API_KEY fallback (or via ADMIN_API_KEY
# directly — either env var works, see auth-middleware.ts's own fallback chain).
INTERNAL_API_KEY=

# Comma-separated list of origins allowed to call the API (both api.py and
# server.ts read this). Defaults to localhost:8000/3000 if unset.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Off (registration disabled) unless explicitly set to "true". With no gate,
# anyone who can reach this port — including everyone on a Tailscale tailnet,
# see README's "Remote access" section — could self-provision a working API
# key with full tool/integration access. Flip this on only for the window
# you actually want a new account created, then set it back to false.
ALLOW_REGISTRATION=false

# docker compose derives its project name from the current directory unless
# this is set — set it explicitly so a checkout in a differently-named
# folder doesn't silently spin up a second, disconnected stack.
COMPOSE_PROJECT_NAME=jarvis-os

# Optional. Not read directly by any code here, but Node/the OS respect it
# implicitly for Date/Intl formatting — set it if logs/timestamps should
# reflect your local timezone instead of UTC.
TZ=

# ---------- Local LLM (offline-first) ----------
# Used by the "llama-cpp" service in docker-compose.yml — bind-mounts
# HOST_MODEL_DIR (read-only) and serves LOCAL_MODEL_FILE from it over an
# OpenAI-compatible API at http://llama-cpp:8080 inside the Docker network.
# Point this at a directory containing a .gguf model you already have.
HOST_MODEL_DIR=./models
LOCAL_MODEL_FILE=your-model.Q4_K_M.gguf

# ---------- Jarvis files/notes ----------
# Used by src/capabilities/providers/files.ts — bind-mounted read-write into the api
# container at /jarvis-files. This is the ONLY folder Jarvis's file tools can
# ever read or write; nothing outside it is reachable, by construction, not
# just convention. Point this at any folder — it's created automatically if
# it doesn't exist yet.
JARVIS_FILES_DIR=./jarvis-notes
# Advanced/rarely needed: the container-internal mount point files.ts reads
# from — defaults to "/jarvis-files", matching the volume target above.
# Only set this if you've also changed that target in docker-compose.yml.
JARVIS_FILES_DIR_MOUNT=

# Used by src/capabilities/providers/obsidian.ts — bind-mounted read-write
# into the api container at /obsidian-vault. Point this at your real,
# existing Obsidian vault's folder on the host. This is the ONLY folder
# Jarvis's vault tools can ever read or write; nothing outside it is
# reachable, by construction, same boundary as JARVIS_FILES_DIR above.
# Left blank on purpose until you set a real path — docker-compose.yml
# falls back to a harmless placeholder folder (./obsidian-vault-unconfigured)
# so the container can still start, but every vault feature stays fully
# disabled (checks this exact env var, not the mount) until you fill this in.
OBSIDIAN_VAULT_DIR=
# Advanced/rarely needed: the container-internal mount point obsidian.ts
# reads from — defaults to "/obsidian-vault", matching the volume target
# above. Only set this if you've also changed that target in docker-compose.yml.
OBSIDIAN_VAULT_DIR_MOUNT=

# ---------- Jarvis Builder (sandboxed coding agent execution) ----------
# Shared secret between the api and jarvis-builder services — jarvis-builder
# holds the only Docker-socket access in this stack (see
# docs/superpowers/specs/2026-07-24-agentic-coding-department-design.md),
# so this header check is a deliberate second layer beyond "only reachable
# on the internal Docker network."
# Generate one with: openssl rand -hex 32
JARVIS_BUILDER_SECRET=

# Real host filesystem path to this repo checkout — must match exactly,
# not a container-remapped path, so jarvis-builder can tell the HOST's
# Docker daemon to bind-mount subdirectories of this same repo into new
# sandbox containers (Docker always resolves bind-mount sources against
# the host, never the calling container's own view of the path).
JARVIS_REPO_HOST_PATH=/mnt/jarvis_home/llm

# ---------- LLM ----------
# Optional cloud fallback — chat already works locally via the llama-cpp
# service above by default (see the Settings panel / localLlmEndpoint). Only
# set this if you want a cloud model available when the local one is down.
# Free, no credit card required: https://console.groq.com
# Cognition router — Jarvis's own multi-key provider pool (replaces the
# prior OmniRoute integration). Comma-separated; supports multiple keys per
# provider so one hitting a rate limit doesn't take the whole provider down.
# GEMINI_API_KEY (singular) is still required separately for voice-native
# mode and semantic memory embeddings, which this does not replace.
GROQ_API_KEYS=
GEMINI_API_KEYS=
GEMINI_API_KEY=

# The agentic coding loop (src/executive/coding-agent.ts) runs on the same
# Groq client as chat/decomposition above — no separate API key needed.
# Originally ran on NVIDIA NIM specifically to isolate its request volume
# from Groq's rate limits; switched after live verification found NVIDIA
# NIM's default model unreliable (wrote empty files, intermittently
# rejected well-formed tool-calling requests outright) and Groq's own free
# tier held up reliably under heavy testing. The tradeoff this reintroduces:
# a busy coding session now shares Groq's rate-limit pool with regular chat.
# llama-3.3-70b-versatile: this codebase's already-proven multi-turn
# tool-calling workhorse (server.ts's main chat flow). Landed here after
# three live-verified dead ends: kimi-k2 isn't available on a real Groq
# account at all; openai/gpt-oss-120b works but its free-tier rate limit
# (8,000 tokens/minute) gets exhausted partway through a real session;
# openai/gpt-oss-20b avoids that but hit Groq's "output_parse_failed" error
# partway through a real multi-turn tool-calling session (its own
# single-shot structured-output calls elsewhere in this codebase are fine
# — see reviewTaskDiff in departments.ts, which still uses it for that
# reason). Overridable without a code change if a stronger option proves
# reliable later — verify real multi-turn tool-calling behavior, not just
# a single test call, before trusting a model's name alone.
JARVIS_CODING_AGENT_MODEL=llama-3.3-70b-versatile
# Real cumulative-token ceiling per coding session (src/executive/coding-agent.ts),
# on top of (not instead of) the existing turn-count caps — a session that
# hits this stops cleanly instead of running up unbounded spend. Deliberately
# a token count, not a dollar figure: Groq pricing varies by model, so
# convert to your own dollar ceiling based on your actual pricing tier.
# Optional — defaults to 4,000,000 if unset or not a positive integer.
JARVIS_CODING_AGENT_TOKEN_BUDGET=

# ---------- GitHub ----------
# Personal Access Token with repo scope, used by src/capabilities/providers/github.ts
GITHUB_TOKEN=
# Which repo the Coding department is allowed to open real PRs against —
# deliberately not a model-suppliable argument, see docs/superpowers/specs/
# 2026-07-21-agent-departments-design.md's Security section.
SELF_REPO_OWNER=
SELF_REPO_NAME=

# ---------- Google Calendar (OAuth) ----------
# Used by src/capabilities/providers/calendar.ts. See README's "Google Calendar setup"
# section for how to create these in Google Cloud. After setting them and
# restarting, visit GET /api/integrations/google/auth-url once to complete
# the one-time authorization — degrades to a clear "not configured"/"not
# authorized yet" error on every calendar route/tool until you do.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Required — the server refuses to start without this (must decode to
# exactly 32 bytes). Encrypts OAuth refresh/access tokens (e.g. the Google
# Calendar tokens above) at rest in Postgres.
# Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# ---------- Email (SMTP & IMAP) ----------
# Used by src/capabilities/providers/email.ts
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=

# ---------- Speech-to-Text / Text-to-Speech (local voice daemon) ----------
# Used by src/interaction/whisper.ts (STT) and src/interaction/tts.ts (TTS)
# as the offline path for /api/voice-input and speak_text/TTS notifications
# respectively, and by src/core/audio-client.ts for the continuous voice
# pipeline. Path to the local voice daemon's (daemon/voice_engine.py) Unix
# domain socket. Defaults to /tmp/jarvis-voice/voice.sock if unset — only
# set this if the daemon is configured to listen somewhere else. Replaces
# the old whisper-cpp/tts HTTP services (and their WHISPER_URL/TTS_URL/
# TTS_API_KEY settings) entirely — see docker-compose.yml's "voice-daemon"
# service.
VOICE_DAEMON_SOCKET=

# ---------- PostgreSQL (pgvector) ----------
# Used by the "postgres" service in docker-compose.yml
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Optional overrides — src/kernel/state/db.ts already defaults these to "postgres"
# (the Docker network service name) and 5432, which is correct for the
# bundled docker-compose.yml as-is. Only set these if you're pointing at a
# Postgres instance outside this compose stack.
POSTGRES_HOST=
POSTGRES_PORT=
# Optional overrides for the scheduler's daily data-retention job
# (src/kernel/scheduler.ts) — how many days of conversation_history and
# transcript_events to keep before pruning. Defaults: 180 and 30.
CONVERSATION_RETENTION_DAYS=
TRANSCRIPT_RETENTION_DAYS=

# ---------- Redis (optional cross-instance state) ----------
# Optional. Unsets by default -- every feature that uses this (KeyPool
# cross-instance cooldown sharing, EventBus's cross-instance relay) falls
# back to local-only, in-memory behavior when this is blank. Only needed
# for a genuine multi-instance deployment, which this codebase doesn't
# fully support yet (see docs/superpowers/plans/
# 2026-08-10-shared-state-multi-tenant-infra.md).
# e.g. redis://redis:6379
REDIS_URL=

# ---------- News ----------
# Used by src/capabilities/providers/news.ts. Free key from https://newsapi.org/
# Reachable via the get_news chat tool or GET /api/integrations/news/headlines
# and /search directly. Degrades to a clear "not configured" error if unset.
NEWS_API_KEY=

# ---------- Web Search (Brave) ----------
# Used by src/capabilities/providers/websearch.ts. Free key from
# https://brave.com/search/api/ (2,000 queries/month on the free tier).
# Reachable via the search_web chat tool or GET /api/integrations/websearch
# directly. Degrades to a clear "not configured" error if unset.
BRAVE_API_KEY=

# ---------- Web Push (PWA proactive notifications) ----------
# Generate with: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Identifies this server to browser push services (FCM, Mozilla's push
# service, etc.) — not a secret shared with any third party beyond that.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Currently unused ----------
# Not read by any code in this repo right now. Left here in case the
# features they map to get reintroduced — safe to ignore.
HARDWARE_PROFILE=
N_BATCH=
N_CTX=
N_THREADS=
OPENAI_API_KEY=
# Legacy Postgres var names — superseded by POSTGRES_USER/PASSWORD/DB above.
PG_DATABASE=
PG_HOST=
PG_PASSWORD=
PG_PORT=
PG_USER=
PG_USE_POSTGRES=
